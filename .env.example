# FalkorDB acessível apenas pela própria máquina
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
GRAPH_NAME=cti_gold

# LLM via LiteLLM (formato provider/modelo); a chave nunca vai para o Git
LLM_MODEL=
LLM_API_KEY=

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Versão dos prompts (entra na chave do cache de LLM)
PROMPT_VERSION=v1
